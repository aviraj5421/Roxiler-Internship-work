{
  "info": {
    "name": "Roxiler Store Rating Platform API",
    "description": "Complete Postman collection for Roxiler Systems Coding Challenge - Store Rating Platform",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "userToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "storeOwnerToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register Normal User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alexander Hamilton Consumer\",\n  \"email\": \"user.alexander@gmail.com\",\n  \"password\": \"User@1234\",\n  \"address\": \"45 Federal Plaza, Apt 12B, Financial District, Metropolis\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "Login - Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set(\"adminToken\", jsonData.data.token);",
                  "    console.log(\"Saved adminToken:\", jsonData.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@roxiler.com\",\n  \"password\": \"Admin@1234\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Login - Store Owner",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set(\"storeOwnerToken\", jsonData.data.token);",
                  "    console.log(\"Saved storeOwnerToken:\", jsonData.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"owner.marcus@gmail.com\",\n  \"password\": \"Owner@1234\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Login - Normal User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set(\"userToken\", jsonData.data.token);",
                  "    console.log(\"Saved userToken:\", jsonData.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user.alexander@gmail.com\",\n  \"password\": \"User@1234\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Get Profile (Me)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            }
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"oldPassword\": \"User@1234\",\n  \"newPassword\": \"User@5678\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/change-password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "change-password"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Admin Endpoints",
      "item": [
        {
          "name": "View Dashboard Statistics",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/dashboard",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "dashboard"]
            }
          }
        },
        {
          "name": "Create Normal User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Benjamin Franklin Shopper\",\n  \"email\": \"user.benjamin2@gmail.com\",\n  \"password\": \"User@1234\",\n  \"address\": \"1776 Independence Boulevard, Liberty City\",\n  \"role\": \"USER\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/users",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "users"]
            }
          }
        },
        {
          "name": "Create Admin User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Secondary System Administrator\",\n  \"email\": \"admin.secondary@roxiler.com\",\n  \"password\": \"Admin@1234\",\n  \"address\": \"500 Corporate Hub, Suite 300, Silicon Valley\",\n  \"role\": \"ADMIN\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/users",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "users"]
            }
          }
        },
        {
          "name": "Create Store",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Downtown Supermarket Emporium\",\n  \"email\": \"contact@emporium.com\",\n  \"address\": \"450 Commercial Avenue, Downtown Metropolis\",\n  \"owner_id\": 2\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/stores",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "stores"]
            }
          }
        },
        {
          "name": "View All Stores (Filter & Sort)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/stores?search=Metropolis&sortBy=overall_rating&order=desc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "stores"],
              "query": [
                {
                  "key": "search",
                  "value": "Metropolis"
                },
                {
                  "key": "sortBy",
                  "value": "overall_rating"
                },
                {
                  "key": "order",
                  "value": "desc"
                }
              ]
            }
          }
        },
        {
          "name": "View All Users (Filter & Sort)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/users?role=STORE_OWNER&sortBy=name&order=asc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "users"],
              "query": [
                {
                  "key": "role",
                  "value": "STORE_OWNER"
                },
                {
                  "key": "sortBy",
                  "value": "name"
                },
                {
                  "key": "order",
                  "value": "asc"
                }
              ]
            }
          }
        },
        {
          "name": "View Store Owner Details (Shows Owner Rating)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/users/2",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "users", "2"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Normal User Endpoints",
      "item": [
        {
          "name": "View Registered Stores (Search & My Rating)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/user/stores?search=Bakery&sortBy=overall_rating&order=desc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "user", "stores"],
              "query": [
                {
                  "key": "search",
                  "value": "Bakery"
                },
                {
                  "key": "sortBy",
                  "value": "overall_rating"
                },
                {
                  "key": "order",
                  "value": "desc"
                }
              ]
            }
          }
        },
        {
          "name": "Submit Store Rating (1 to 5)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"store_id\": 1,\n  \"rating\": 5\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/user/ratings",
              "host": ["{{baseUrl}}"],
              "path": ["api", "user", "ratings"]
            }
          }
        },
        {
          "name": "Modify Existing Rating",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rating\": 4\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/user/ratings/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "user", "ratings", "1"]
            }
          }
        },
        {
          "name": "View My Submitted Ratings",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/user/ratings",
              "host": ["{{baseUrl}}"],
              "path": ["api", "user", "ratings"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Store Owner Endpoints",
      "item": [
        {
          "name": "View Store Dashboard (Average Rating)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{storeOwnerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/store-owner/dashboard",
              "host": ["{{baseUrl}}"],
              "path": ["api", "store-owner", "dashboard"]
            }
          }
        },
        {
          "name": "View User Ratings for Store",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{storeOwnerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/store-owner/ratings?sortBy=rating&order=desc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "store-owner", "ratings"],
              "query": [
                {
                  "key": "sortBy",
                  "value": "rating"
                },
                {
                  "key": "order",
                  "value": "desc"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}
